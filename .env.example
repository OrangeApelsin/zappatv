# ==========================================
# Zappa 2 Environment Configuration Template
# ==========================================
# Copy this file to .env or set variables in your CI/CD runner.
# Do NOT commit .env with real credentials.

# --- CI & Release Automation ---
# Personal Access Token with repository and release write permissions
CI_TOKEN=
GITEA_TOKEN=
RELEASE_TOKEN=

# CI repository identifier (e.g., owner/zappa2)
CI_REPOSITORY=owner/zappa2

# CI server base URL (e.g., https://git.example.com)
CI_SERVER_URL=

# --- TV Deployment & Hardware Calibration ---
# Target Samsung Tizen TV local IP address for manual SDB deployment (e.g., 192.168.1.50)
TV_IP=

# Optional Tizen signing profile name (if using local Tizen Studio certificates)
SIGNING_PROFILE=

# Target Tizen OS version (5.0, 5.5, 6.0, 6.5, 7.0, 8.0, 9.0, 10.0; default: 5.5)
TIZEN_TARGET=5.5

# --- Local IPTV Development Server ---
# IPTV Manager backend endpoint for local testing
IPTV_SERVER_URL=http://localhost:8000
